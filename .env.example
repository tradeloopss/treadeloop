# TradeLoop environment: example values only. Real values belong in
# .env.local (development), the Vercel project settings (app) and
# /etc/tradeloop/*.env on the sync VPS (workers). Never commit real values.

# ── Shared by the app and the sync workers ──────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/postgres
# 64 hex chars (32 bytes). Encrypts broker credentials and Tradovate tokens
# at rest. The app and the workers must use the same key.
BROKER_CREDENTIALS_KEY=
# Bearer secret for /api/cron/*; the workers call the app with it.
CRON_SECRET=
# Public URL of the app (OAuth redirect URIs are built from it).
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# ── Tradovate (docs/integrations/tradovate.md) ───────────────────────────────
# off (default) | mock | staging | production
#   mock        fixture data, no network, runs in the app; refused on production
#   staging     Tradovate/NinjaTrader partner staging hosts (*.staging.ninjatrader.dev)
#   production  demo.tradovateapi.com / live.tradovateapi.com; needs certification
TRADOVATE_MODE=off

# OAuth client issued by Tradovate. The secret stays on the server and is
# only ever sent to Tradovate's token endpoint.
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
# Tradovate's sign-in page. Production defaults to https://trader.tradovate.com/oauth;
# staging has no public default, so use the URL Tradovate gives you.
TRADOVATE_OAUTH_AUTHORIZE_URL=
# Default: <live REST base>/auth/oauthtoken
TRADOVATE_OAUTH_TOKEN_URL=
# Default: ${APP_URL}/api/integrations/tradovate/callback. It must match the
# redirect URI registered with Tradovate exactly.
TRADOVATE_REDIRECT_URI=
# Only if Tradovate assigns scopes to your client.
TRADOVATE_OAUTH_SCOPE=

# Which Tradovate environments to sync (default: demo,live).
TRADOVATE_ENVIRONMENTS=demo,live
# Host overrides. By default each mode uses Tradovate's documented hosts.
# TRADOVATE_API_BASE_URL=https://live.tradovateapi.com/v1
# TRADOVATE_WS_URL=wss://live.tradovateapi.com/v1/websocket
# TRADOVATE_DEMO_API_BASE_URL=https://demo.tradovateapi.com/v1
# TRADOVATE_DEMO_WS_URL=wss://demo.tradovateapi.com/v1/websocket

# Reserved: only set these if Tradovate issues API-key (app id / version)
# credentials instead of OAuth.
# TRADOVATE_APP_ID=
# TRADOVATE_APP_VERSION=

# ── Tradovate worker only (sync VPS: /etc/tradeloop/tradovate-worker.env) ────
# Also needs TRADOVATE_MODE, TRADOVATE_CLIENT_ID, TRADOVATE_CLIENT_SECRET,
# BROKER_CREDENTIALS_KEY, CRON_SECRET and APP_URL from above.
TRADOVATE_SYNC_CONCURRENCY=3
TRADOVATE_STATUS_FILE=/var/lib/tradeloop/tradovate-status.json

# ── Tradovate via NinjaTrader on the VPS (docs/integrations/ninjatrader.md) ──
# Set on BOTH the app and the worker to offer the credentials path in Add
# account and accept the add-on's relay posts. Must be "tlnt_" + random.
# NINJATRADER_RELAY_SECRET=tlnt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── NinjaTrader worker only (sync VPS: /etc/tradeloop/ninjatrader-worker.env) ─
# Also needs APP_URL and, from db.env, DATABASE_URL + BROKER_CREDENTIALS_KEY.
# NINJATRADER_PROVISION_TOKEN=            # the local provisioner's bearer (long random)
# NINJATRADER_PROVISION_PORT=9210
# NINJATRADER_ADDON_FILE=/var/lib/tradeloop/TradeLoopRelay.cs
# NINJATRADER_STATUS_FILE=/var/lib/tradeloop/ninjatrader-status.json
